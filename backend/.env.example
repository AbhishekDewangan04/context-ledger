# Server port and browser origin allowed by CORS.
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
# Optional comma-separated additional origins.
CORS_ALLOWED_ORIGINS=

# Required bearer API key for REST and MCP access.
CONTEXT_LEDGER_API_KEY=
# Optional comma-separated key rotation values.
CONTEXT_LEDGER_API_KEYS=

# Primary Redis storage (Upstash).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Alternative Redis storage (Vercel KV).
KV_REST_API_URL=
KV_REST_API_TOKEN=
