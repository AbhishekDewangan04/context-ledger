# Required: Bearer API key for MCP and dashboard access
CONTEXT_LEDGER_API_KEY=
# Optional: Comma-separated list of additional valid keys for key rotation
CONTEXT_LEDGER_API_KEYS=

# Primary Redis storage (Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Alternative Redis storage (Vercel KV)
KV_REST_API_URL=
KV_REST_API_TOKEN=
